---
// Quiet redirect for individuals who land on the brand-facing homepage.
// Sits below the contact form so brand visitors see the full pitch first.
---

<div class="bg-base-light border-t border-white/[0.04]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center">
    <p class="text-sm text-white/40">
      Not a brand? Looking to earn instead?
      <a href="/start-your-business" class="ml-1 text-yellow/80 hover:text-yellow font-medium transition-colors duration-300">
        Start your own business with Merch &amp; Move
        <span aria-hidden="true">&rarr;</span>
      </a>
    </p>
  </div>
</div>
