---
// Quiet redirect for individuals who land on the brand-facing homepage.
// Sits below the contact form so brand visitors see the full pitch first.
---

<div class="seller-strip relative overflow-hidden">
  <div class="absolute top-0 left-0 right-0 section-divider z-0"></div>

  <!-- Swirling lines: loose, uneven curves in yellow and sky, two layers drifting opposite ways -->
  <svg class="swirl swirl-a" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="swirl-yellow" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#F9D702" stop-opacity="0" />
        <stop offset="25%" stop-color="#F9D702" stop-opacity="1" />
        <stop offset="70%" stop-color="#FFDF3A" stop-opacity="1" />
        <stop offset="100%" stop-color="#F9D702" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="swirl-sky" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#3EB5E1" stop-opacity="0" />
        <stop offset="30%" stop-color="#6BC5E8" stop-opacity="1" />
        <stop offset="75%" stop-color="#3EB5E1" stop-opacity="1" />
        <stop offset="100%" stop-color="#3EB5E1" stop-opacity="0" />
      </linearGradient>
    </defs>
    <!-- long loose ribbon with a curl near the left -->
    <path d="M-120,110 C60,20 140,150 230,90 c40,-28 -20,-70 -10,-30 c12,48 160,-40 300,-10 C640,80 720,20 860,70 c70,25 120,-60 230,-20 c60,22 90,90 200,70 c80,-15 160,-110 380,-60" stroke="url(#swirl-yellow)" stroke-width="1.6" fill="none" opacity="0.55" />
    <!-- wobbly sky line that dips and kicks -->
    <path d="M-100,30 c120,90 220,-20 330,40 c50,28 40,90 110,60 c60,-26 20,-100 130,-70 c90,25 120,110 260,50 c80,-34 60,-90 150,-40 c60,34 140,70 260,10 c70,-35 140,20 330,60" stroke="url(#swirl-sky)" stroke-width="1.2" fill="none" opacity="0.5" />
    <!-- short yellow flick -->
    <path d="M900,125 c60,-70 140,-30 210,-90" stroke="url(#swirl-yellow)" stroke-width="2.2" stroke-linecap="round" fill="none" opacity="0.45" />
    <!-- sky curl on the right -->
    <path d="M1150,35 c40,60 -60,90 -30,40 c30,-50 120,10 170,60 c30,30 110,20 190,-30" stroke="url(#swirl-sky)" stroke-width="1.8" fill="none" opacity="0.5" />
  </svg>
  <svg class="swirl swirl-b" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
    <!-- lazy yellow drift low across the middle -->
    <path d="M-100,95 c140,-60 240,50 360,20 c80,-20 60,-60 140,-45 c90,17 110,80 230,55 c70,-15 80,-70 170,-40 c80,27 110,60 240,20 c110,-34 210,40 420,-20" stroke="url(#swirl-yellow)" stroke-width="1" fill="none" opacity="0.4" />
    <!-- sky loop-de-loop left of centre -->
    <path d="M-60,60 c100,-40 170,60 270,30 c50,-15 30,-55 60,-30 c30,25 -40,60 0,60 c40,0 60,-55 120,-45 c100,17 130,90 260,45 c110,-38 150,-95 330,-45 c110,30 170,60 330,10" stroke="url(#swirl-sky)" stroke-width="1.3" fill="none" opacity="0.42" />
    <!-- dotted yellow scribble top right -->
    <path d="M1000,15 c50,40 120,-20 170,30 c40,40 100,40 160,0" stroke="url(#swirl-yellow)" stroke-width="1.4" stroke-dasharray="3 7" stroke-linecap="round" fill="none" opacity="0.6" />
    <!-- tiny sky flick bottom left -->
    <path d="M80,135 c40,-40 90,-30 130,-70" stroke="url(#swirl-sky)" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.45" />
  </svg>

  <!-- Glow pockets and grid -->
  <div class="mesh-orb mesh-orb-yellow w-[700px] h-[300px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-30 z-0"></div>
  <div class="mesh-orb mesh-orb-sky w-[320px] h-[320px] top-1/2 -translate-y-1/2 left-[6%] opacity-25 z-0"></div>
  <div class="mesh-orb mesh-orb-sky w-[360px] h-[360px] top-1/2 -translate-y-1/2 right-[10%] opacity-20 z-0"></div>
  <div class="absolute inset-0 dot-grid opacity-40 z-0"></div>
  <div class="absolute inset-0 max-w-7xl mx-auto grid-lines z-0"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 text-center">
    <p class="inline-flex flex-wrap items-center justify-center gap-x-1.5 gap-y-1 px-5 py-2.5 rounded-full bg-base/60 border border-white/[0.06] backdrop-blur-md text-sm sm:text-[15px] text-white/80">
      <span class="text-yellow font-semibold">Not a brand?</span>
      <span>Looking to earn instead?</span>
      <a href="/start-your-business" class="group inline-flex items-center text-white font-semibold hover:text-yellow transition-colors duration-300">
        Start your own business with Merch &amp; Move
        <svg class="ml-1.5 w-4 h-4 text-yellow group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </p>
  </div>
</div>

<style>
  .seller-strip {
    background:
      radial-gradient(ellipse 60% 120% at 50% 50%, rgba(249, 215, 2, 0.06) 0%, transparent 70%),
      linear-gradient(90deg, #080F1E 0%, #0E1A30 50%, #080F1E 100%);
  }

  .swirl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    filter: drop-shadow(0 0 5px rgba(249, 215, 2, 0.18));
  }

  /* Each layer is drawn wider than the viewport and drifts sideways so the
     curves appear to flow. Opposite directions give a gentle interweave. */
  .swirl-a { animation: swirl-drift-a 26s ease-in-out infinite alternate; }
  .swirl-b { animation: swirl-drift-b 34s ease-in-out infinite alternate; }

  @keyframes swirl-drift-a {
    from { transform: translateX(-2.5%) translateY(2px) rotate(-0.4deg); }
    to   { transform: translateX(2.5%) translateY(-5px) rotate(0.3deg); }
  }
  @keyframes swirl-drift-b {
    from { transform: translateX(3%) translateY(4px) rotate(0.5deg) scaleY(1.04); }
    to   { transform: translateX(-2%) translateY(-2px) rotate(-0.3deg) scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .swirl-a, .swirl-b { animation: none; }
  }
</style>
