---
// Quiet redirect for individuals who land on the brand-facing homepage.
// Sits below the contact form so brand visitors see the full pitch first.
---

<a href="/start-your-business" class="seller-strip group relative block overflow-hidden" aria-label="Not a brand? Looking to earn instead? Start your own business with Merch & Move">
  <div class="absolute top-0 left-0 right-0 section-divider z-0"></div>

  <!-- Swirling lines: loose, uneven curves in yellow and sky. Three layers: a soft
       blurred glow layer at the back, then two crisp layers drifting opposite ways.
       Gradients travel along the strokes so light appears to run down the lines,
       and a few short flicks draw themselves in and out. -->
  <svg class="swirl swirl-glow" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
    <path d="M-120,110 C60,20 140,150 230,90 c40,-28 -20,-70 -10,-30 c12,48 160,-40 300,-10 C640,80 720,20 860,70 c70,25 120,-60 230,-20 c60,22 90,90 200,70 c80,-15 160,-110 380,-60" stroke="#F9D702" stroke-width="6" fill="none" opacity="0.10" />
    <path d="M-100,30 c120,90 220,-20 330,40 c50,28 40,90 110,60 c60,-26 20,-100 130,-70 c90,25 120,110 260,50 c80,-34 60,-90 150,-40 c60,34 140,70 260,10 c70,-35 140,20 330,60" stroke="#3EB5E1" stroke-width="6" fill="none" opacity="0.10" />
  </svg>

  <svg class="swirl swirl-a" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="swirl-yellow" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1440" y2="0">
        <stop offset="0" stop-color="#F9D702" stop-opacity="0.15" />
        <stop offset="0.45" stop-color="#F9D702" stop-opacity="0.35" />
        <stop offset="0.5" stop-color="#FFF3A0" stop-opacity="1" />
        <stop offset="0.55" stop-color="#F9D702" stop-opacity="0.35" />
        <stop offset="1" stop-color="#F9D702" stop-opacity="0.15" />
        <animate attributeName="x1" values="-1440;1440" dur="11s" repeatCount="indefinite" />
        <animate attributeName="x2" values="0;2880" dur="11s" repeatCount="indefinite" />
      </linearGradient>
      <linearGradient id="swirl-sky" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1440" y2="0">
        <stop offset="0" stop-color="#3EB5E1" stop-opacity="0.15" />
        <stop offset="0.45" stop-color="#3EB5E1" stop-opacity="0.35" />
        <stop offset="0.5" stop-color="#CFF0FA" stop-opacity="1" />
        <stop offset="0.55" stop-color="#3EB5E1" stop-opacity="0.35" />
        <stop offset="1" stop-color="#3EB5E1" stop-opacity="0.15" />
        <animate attributeName="x1" values="1440;-1440" dur="14s" repeatCount="indefinite" />
        <animate attributeName="x2" values="2880;0" dur="14s" repeatCount="indefinite" />
      </linearGradient>
    </defs>
    <!-- long loose ribbon with a curl near the left -->
    <path d="M-120,110 C60,20 140,150 230,90 c40,-28 -20,-70 -10,-30 c12,48 160,-40 300,-10 C640,80 720,20 860,70 c70,25 120,-60 230,-20 c60,22 90,90 200,70 c80,-15 160,-110 380,-60" stroke="url(#swirl-yellow)" stroke-width="1.6" fill="none" />
    <!-- wobbly sky line that dips and kicks -->
    <path d="M-100,30 c120,90 220,-20 330,40 c50,28 40,90 110,60 c60,-26 20,-100 130,-70 c90,25 120,110 260,50 c80,-34 60,-90 150,-40 c60,34 140,70 260,10 c70,-35 140,20 330,60" stroke="url(#swirl-sky)" stroke-width="1.2" fill="none" />
    <!-- short yellow flick that draws itself -->
    <path class="draw draw-1" d="M900,125 c60,-70 140,-30 210,-90" stroke="#FFDF3A" stroke-width="2.2" stroke-linecap="round" fill="none" opacity="0.7" />
    <!-- sky curl on the right -->
    <path d="M1150,35 c40,60 -60,90 -30,40 c30,-50 120,10 170,60 c30,30 110,20 190,-30" stroke="url(#swirl-sky)" stroke-width="1.8" fill="none" />
    <!-- sparks -->
    <circle class="spark spark-1" cx="232" cy="88" r="2" fill="#FFF3A0" />
    <circle class="spark spark-2" cx="1122" cy="72" r="1.6" fill="#CFF0FA" />
  </svg>

  <svg class="swirl swirl-b" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
    <!-- lazy yellow drift low across the middle -->
    <path d="M-100,95 c140,-60 240,50 360,20 c80,-20 60,-60 140,-45 c90,17 110,80 230,55 c70,-15 80,-70 170,-40 c80,27 110,60 240,20 c110,-34 210,40 420,-20" stroke="url(#swirl-yellow)" stroke-width="1" fill="none" opacity="0.8" />
    <!-- sky loop-de-loop left of centre -->
    <path d="M-60,60 c100,-40 170,60 270,30 c50,-15 30,-55 60,-30 c30,25 -40,60 0,60 c40,0 60,-55 120,-45 c100,17 130,90 260,45 c110,-38 150,-95 330,-45 c110,30 170,60 330,10" stroke="url(#swirl-sky)" stroke-width="1.3" fill="none" opacity="0.85" />
    <!-- dotted yellow scribble top right -->
    <path class="dash-run" d="M1000,15 c50,40 120,-20 170,30 c40,40 100,40 160,0" stroke="#FFDF3A" stroke-width="1.4" stroke-dasharray="3 7" stroke-linecap="round" fill="none" opacity="0.6" />
    <!-- tiny sky flick bottom left, draws itself -->
    <path class="draw draw-2" d="M80,135 c40,-40 90,-30 130,-70" stroke="#6BC5E8" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.7" />
    <!-- sparks -->
    <circle class="spark spark-3" cx="330" cy="68" r="1.8" fill="#CFF0FA" />
    <circle class="spark spark-4" cx="1290" cy="42" r="2.2" fill="#FFF3A0" />
  </svg>

  <!-- Glow pockets and grid -->
  <div class="mesh-orb mesh-orb-yellow w-[700px] h-[300px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-30 z-0"></div>
  <div class="mesh-orb mesh-orb-sky w-[320px] h-[320px] top-1/2 -translate-y-1/2 left-[6%] opacity-25 z-0"></div>
  <div class="mesh-orb mesh-orb-sky w-[360px] h-[360px] top-1/2 -translate-y-1/2 right-[10%] opacity-20 z-0"></div>
  <div class="absolute inset-0 dot-grid opacity-40 z-0"></div>
  <div class="absolute inset-0 max-w-7xl mx-auto grid-lines z-0"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 text-center">
    <span class="inline-flex flex-wrap items-center justify-center gap-x-1.5 gap-y-1 px-5 py-2.5 rounded-full bg-base/60 border border-white/[0.06] group-hover:border-yellow/40 group-hover:bg-base/80 backdrop-blur-md text-sm sm:text-[15px] text-white/80 transition-all duration-300">
      <span class="text-yellow font-semibold">Not a brand?</span>
      <span>Looking to earn instead?</span>
      <span class="inline-flex items-center text-white font-semibold group-hover:text-yellow transition-colors duration-300">
        Start your own business with Merch &amp; Move
        <svg class="ml-1.5 w-4 h-4 text-yellow group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </span>
    </span>
  </div>
</a>

<style>
  .seller-strip {
    background:
      radial-gradient(ellipse 60% 120% at 50% 50%, rgba(249, 215, 2, 0.06) 0%, transparent 70%),
      linear-gradient(90deg, #080F1E 0%, #0E1A30 50%, #080F1E 100%);
  }

  .swirl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: visible;
  }

  .swirl-glow { filter: blur(6px); animation: swirl-drift-a 26s ease-in-out infinite alternate; }
  .seller-strip:hover .swirl-a, .seller-strip:hover .swirl-b { opacity: 1; }
  .swirl-a, .swirl-b { opacity: 0.85; transition: opacity 0.4s ease; }
  .swirl-a { filter: drop-shadow(0 0 4px rgba(249, 215, 2, 0.25)); animation: swirl-drift-a 26s ease-in-out infinite alternate; }
  .swirl-b { filter: drop-shadow(0 0 4px rgba(62, 181, 225, 0.25)); animation: swirl-drift-b 34s ease-in-out infinite alternate; }

  /* Each layer is drawn wider than the viewport and drifts sideways so the
     curves appear to flow. Opposite directions give a gentle interweave. */
  @keyframes swirl-drift-a {
    from { transform: translateX(-2.5%) translateY(2px) rotate(-0.4deg); }
    to   { transform: translateX(2.5%) translateY(-5px) rotate(0.3deg); }
  }
  @keyframes swirl-drift-b {
    from { transform: translateX(3%) translateY(4px) rotate(0.5deg) scaleY(1.04); }
    to   { transform: translateX(-2%) translateY(-2px) rotate(-0.3deg) scaleY(1); }
  }

  /* Short flicks draw in, hold, then undraw. */
  .draw { stroke-dasharray: 320; stroke-dashoffset: 320; }
  .draw-1 { animation: draw-line 7s ease-in-out infinite; }
  .draw-2 { animation: draw-line 9s ease-in-out infinite 2.5s; }
  @keyframes draw-line {
    0%   { stroke-dashoffset: 320; }
    35%  { stroke-dashoffset: 0; }
    60%  { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -320; }
  }

  /* Dotted scribble marches along its path. */
  .dash-run { animation: dash-run 4s linear infinite; }
  @keyframes dash-run { to { stroke-dashoffset: -40; } }

  /* Sparks twinkle at the bends. */
  .spark { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .spark-1 { animation: twinkle 5s ease-in-out infinite 0.8s; }
  .spark-2 { animation: twinkle 6s ease-in-out infinite 2.2s; }
  .spark-3 { animation: twinkle 7s ease-in-out infinite 1.4s; }
  .spark-4 { animation: twinkle 5.5s ease-in-out infinite 3.6s; }
  @keyframes twinkle {
    0%, 70%, 100% { opacity: 0; transform: scale(0.6); }
    80% { opacity: 1; transform: scale(1.6); }
    90% { opacity: 0.6; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .swirl, .draw, .dash-run, .spark { animation: none; }
    .draw { stroke-dashoffset: 0; }
    .spark { opacity: 0.6; }
  }
</style>
