---
// Quiet redirect for individuals who land on the brand-facing homepage.
// Sits below the contact form so brand visitors see the full pitch first.
---

<div class="relative bg-base-light overflow-hidden">
  <div class="absolute top-0 left-0 right-0 section-divider"></div>
  <div class="mesh-orb mesh-orb-yellow w-[600px] h-[400px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-40"></div>
  <div class="mesh-orb mesh-orb-sky w-[300px] h-[300px] top-1/2 -translate-y-1/2 right-[12%] opacity-20"></div>
  <div class="absolute inset-0 dot-grid opacity-40"></div>
  <div class="absolute inset-0 max-w-7xl mx-auto grid-lines"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
    <p class="text-[11px] font-bold tracking-[0.25em] text-yellow/70 uppercase mb-3">Not a brand?</p>
    <p class="text-sm sm:text-base text-white/60">
      Looking to earn instead?
      <a href="/start-your-business" class="group inline-flex items-center ml-1.5 text-white font-medium hover:text-yellow transition-colors duration-300">
        Start your own business with Merch &amp; Move
        <svg class="ml-1.5 w-4 h-4 text-yellow group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </p>
  </div>
</div>
